@echo off
setlocal DisableDelayedExpansion
set "CLAUDE_MCP_SELF=%~f0"
set "CLAUDE_MCP_MODE=%~1"
powershell.exe -NoProfile -Command "$r=[IO.File]::ReadAllText($env:CLAUDE_MCP_SELF);$p=$r.Substring($r.LastIndexOf(':__CLAUDE_MCP_PAYLOAD__')+23).Trim();$s=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($p)); & ([scriptblock]::Create($s))"
set "CLAUDE_MCP_RESULT=%errorlevel%"
if /I "%CLAUDE_MCP_MODE%"=="--check" goto done
pause
:done
exit /b %CLAUDE_MCP_RESULT%
:__CLAUDE_MCP_PAYLOAD__

